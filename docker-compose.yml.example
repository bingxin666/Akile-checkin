services:
  akile-checkin:
    image: ghcr.io/bingxin666/akile-checkin:latest
    container_name: akile-checkin
    restart: unless-stopped
    environment:
      # 是否启用定时模式（镜像默认已开启）
      RUN_SCHEDULED: "true"
      # 每日签到时间（HH:MM）
      AKILE_CHECKIN_TIME: "10:00"
      # 签到随机延迟范围（±分钟）
      AKILE_RANDOM_DELAY_MINUTES: "5"
      # 也可用环境变量配置账号，优先级高于 config.ini
      # AKILE_EMAIL: your_email@example.com
      # AKILE_PASSWORD: your_password
      # AKILE_TOTP: your_totp_secret
      # AKILE_PUSH_KEY: your_serverchan_key
    volumes:
      - ./config.ini:/app/config.ini
      - ./chrome_session:/app/chrome_session
